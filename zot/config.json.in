{
  "distSpecVersion": "1.1.1",

  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },

  "http": {
    "address": "0.0.0.0",
    "port": "8080",
    "realm": "zot",
    "compat": ["docker2s2"],

    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "sessionKeysFile": "/etc/zot/session-keys.json",
      "failDelay": 5
    },

    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": ["ci"],
              "actions": ["read", "create", "update"]
            }
          ],
          "defaultPolicy": ["read"],
          "anonymousPolicy": ["read"]
        }
      },
      "adminPolicy": {
        "users": ["admin"],
        "actions": ["read", "create", "update", "delete"]
      },
      "metrics": {
        "users": ["metrics"]
      }
    }
  },

  "log": {
    "level": "info"
  },

  "extensions": {
    "ui": {
      "enable": true
    },
    "search": {
      "enable": true
    },
    "scrub": {
      "enable": true,
      "interval": "24h"
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    }
  }
}
