{
  "distSpecVersion": "1.1.1",

  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",

    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": ["local/**"],
          "deleteReferrers": false,
          "deleteUntagged": false,
          "keepTags": [
            { "patterns": [".*"] }
          ]
        },
        {
          "repositories": ["**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            { "patterns": [".*"], "pulledWithin": "720h" }
          ]
        }
      ]
    }
  },

  "http": {
    "address": "0.0.0.0",
    "port": "8080",
    "realm": "zot",
    "compat": ["docker2s2"],

    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "sessionKeysFile": "/etc/zot/session-keys.json",
      "failDelay": 5
    },

    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": ["ci"],
              "actions": ["read", "create", "update"]
            }
          ],
          "defaultPolicy": ["read"],
          "anonymousPolicy": ["read"]
        }
      },
      "adminPolicy": {
        "users": ["admin"],
        "actions": ["read", "create", "update", "delete"]
      },
      "metrics": {
        "users": ["metrics"]
      }
    }
  },

  "log": {
    "level": "info"
  },

  "extensions": {
    "ui": {
      "enable": true
    },
    "search": {
      "enable": true
    },
    "scrub": {
      "enable": true,
      "interval": "24h"
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "2s",
          "content": [
            { "prefix": "library/**" },
            { "prefix": "sbates130272/**" },
            { "prefix": "rocm/**" },
            { "prefix": "grafana/**" },
            { "prefix": "prom/**" },
            { "prefix": "fireflyiii/**" },
            { "prefix": "offen/**" },
            { "prefix": "mbentley/**" },
            { "prefix": "billimek/**" },
            { "prefix": "moby/**" }
          ]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "2s",
          "content": [
            { "prefix": "home-assistant/**" },
            { "prefix": "project-zot/**" }
          ]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "2s",
          "content": [
            { "prefix": "prometheus/**" }
          ]
        }
      ]
    }
  }
}
