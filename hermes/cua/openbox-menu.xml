<?xml version="1.0" encoding="UTF-8"?>
<!--
  The desktop's root menu.

  This is load-bearing, not decoration. Hermes' computer_use vocabulary is
  capture / click / type / key / drag / scroll / focus_app / list_apps.
  There is no "launch an application" action anywhere in it, so an agent
  facing a desktop with nothing running has no move that starts one. The
  openbox root menu is the way a human would do it, and a right-click on
  the desktop followed by a click on a menu item is entirely within what
  the agent can already express.

  Debian's openbox package points at /var/lib/openbox/debian-menu.xml,
  which is generated by menu-xdg from installed .desktop files and is
  absent in a slim image. Shipping this one keeps the menu from being
  empty, and keeps it to the handful of things worth putting in front of
  an agent rather than every app on the system.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="root-menu" label="Applications">
    <item label="Web Browser">
      <action name="Execute"><execute>firefox-esr</execute></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><execute>xterm</execute></action>
    </item>
    <separator/>
    <item label="Restart Web Browser">
      <!-- Firefox is the one thing in here that can hit the container's
           memory ceiling. Recovery should not need a human on the host. -->
      <action name="Execute">
        <execute>sh -c 'pkill -f firefox-esr; sleep 2; firefox-esr'</execute>
      </action>
    </item>
  </menu>

</openbox_menu>
