      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Finished"
          }
        ]
      },
      "pluginVersion": "13.0.1+security-01",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_join(github_actions_workflow_last_run_conclusion{repo=~\"$repo\"}, \"wfkey\", \"@\", \"repo\", \"workflow\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (wfkey) (label_join(github_actions_workflow_last_run_timestamp_seconds, \"wfkey\", \"@\", \"repo\", \"workflow\")) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
