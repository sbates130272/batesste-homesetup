              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Repo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Workflow"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 340
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "action_required": {
                        "color": "orange",
                        "index": 4
                      },
                      "cancelled": {
                        "color": "text",
                        "index": 5
                      },
                      "failure": {
                        "color": "red",
                        "index": 1
                      },
                      "skipped": {
                        "color": "text",
                        "index": 6
                      },
                      "startup_failure": {
                        "color": "red",
                        "index": 3
                      },
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "timed_out": {
