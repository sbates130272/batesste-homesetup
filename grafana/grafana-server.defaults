# /etc/default/grafana-server
#
# Consumed by the grafana-server systemd unit via EnvironmentFile=.
# Stock paths are kept here so they stay version-controlled; any
# Grafana .ini overrides use the GF_<SECTION>_<KEY> convention.

GRAFANA_USER=grafana
GRAFANA_GROUP=grafana
GRAFANA_HOME=/usr/share/grafana

LOG_DIR=/var/log/grafana
DATA_DIR=/var/lib/grafana
MAX_OPEN_FILES=10000

CONF_DIR=/etc/grafana
CONF_FILE=/etc/grafana/grafana.ini
RESTART_ON_UPGRADE=true
PLUGINS_DIR=/var/lib/grafana/plugins
PROVISIONING_CFG_DIR=/etc/grafana/provisioning

# Only used on systemd systems
PID_FILE_DIR=/run/grafana

# ── Grafana .ini overrides ──────────────────────────────────────
# Bind to all interfaces so the UI is reachable on every address
# (LAN, Tailscale, Docker bridge, etc.).
GF_SERVER_HTTP_ADDR=0.0.0.0

# The funnel-gateway vhost proxies /grafana/ without stripping the
# prefix, so Grafana has to know it is served from a sub path.
# Without these it emits root-relative redirects to /login, which the
# gateway does not route, and every /grafana/ request 404s.
# Note this moves direct access too: use :3000/grafana/, not :3000/.
GF_SERVER_ROOT_URL=https://snoc-beelink.fold-leaffish.ts.net/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true

# ── Firefly III datasource ──────────────────────────────────
# Password for the firefly MySQL user that the firefly-mysql
# provisioned datasource connects with.
FIREFLY_DB_PASSWORD=thishastochange

# ── Alerting ────────────────────────────────────────────────
# ntfy topic URL for the batesste-ntfy contact point in
# provisioning/alerting/contact-points.yaml. On ntfy.sh the topic
# URL is the credential -- anyone holding it can read and publish
# to the topic -- so use an unguessable topic name and do not
# commit the real one. Set it on the host and keep the placeholder
# here.
#
# Verify delivery after changing it. A wrong URL does not error;
# ntfy accepts a POST to any topic, including one nobody is
# subscribed to, so a typo is indistinguishable from silence:
#   curl -d "test" "$NTFY_TOPIC_URL"
NTFY_TOPIC_URL=thishastochange
